{
	"name": "omp-molt",
	"version": "0.1.0",
	"description": "Local semantic context optimizer for omp: LLM-summarizes stale conversation ranges when projected cache-aware savings beat the one-time prompt-cache bust.",
	"license": "MIT",
	"type": "module",
	"exports": "./src/index.ts",
	"files": [
		"src",
		"README.md"
	],
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@oh-my-pi/pi-ai": "17.0.6",
		"@oh-my-pi/pi-coding-agent": "17.0.6",
		"eslint": "^10.15.0",
		"prettier": "^3.10.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.1"
	}
}
